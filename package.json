{
  "name": "sgl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SGL \u00e2\u20ac\u201d Structured Graphing Language. Text-first diagramming: JSON-esque source in, SVG out.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "grammar": "pnpm --filter @sgl/core grammar",
    "typecheck": "tsc -b && tsc -p apps/web --noEmit",
    "lint": "eslint .",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "dev": "pnpm --filter @sgl/web dev",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "clean": "rimraf \"packages/*/dist\" \"apps/*/dist\" .tsbuild",
    "changeset": "changeset",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "fast-check": "^4.3.0",
    "rimraf": "^6.0.1",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
