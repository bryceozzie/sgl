{
  "name": "@sgl/layout-api",
  "version": "0.0.0",
  "description": "The LayoutEngine contract, registry, worker host, result validation and host fallbacks.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    },
    "./compose": {
      "types": "./dist/compose.d.ts",
      "default": "./dist/compose.js"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@sgl/core": "workspace:*"
  }
}
