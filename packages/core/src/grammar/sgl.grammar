// SGL surface grammar — normative source is DD-01 §2.
//
// Compiled by @lezer/generator at build time into sgl.parser.js +
// sgl.parser.terms.js, both of which are committed (DD-10 §3) so that a checkout
// builds without the generator and `git blame` on the parser stays meaningful.
// CI regenerates and fails if the committed output differs.

// A document is either a bare entry list or one anonymous root block —
// the second form is what makes any JSON object a valid SGL document.
@top Document { Block | Entry* }

@skip { space | LineComment | BlockComment | "," }

Entry { ConfigEntry | EdgeStmt | NodeDecl }

// ---- configuration ----------------------------------------------------
ConfigEntry { (ConfigKey | ConfigString) ":" Value }

// ---- nodes ------------------------------------------------------------
NodeDecl  { NodeKey (":" NodeValue)? }
NodeKey   { Identifier | String }
NodeValue { Block | String | ConfigString | MultilineString | ClassRef }
// A class name, qualified by the namespaces of `@imports` (A9, I16):
// `lambda: aws.Lambda`, `b.c.Lambda`. A production, not a token, so no new
// token overlaps Identifier; "." never starts an entry, so there is no LR
// conflict at the end of a NodeDecl, and a following `../x -> y` still lexes
// as Parent (`@precedence { Parent, "." }` below). DD-01 §2 has the audit.
ClassRef  { qualified }
Block     { "{" Entry* "}" }

// ---- edges ------------------------------------------------------------
EdgeStmt  { Endpoint (EdgeOp Endpoint)+ (":" EdgeValue)? }
EdgeValue { String | ConfigString | MultilineString | Block }
Endpoint  { Path Port? }
Port      { "[" Identifier "]" }
Path      { Root? Parent* PathStep ("." PathStep)* }
PathStep  { PathSegment | Wildcard }
PathSegment { Identifier | String }

// ---- values (configuration context only) ------------------------------
// MultilineString (`"""`, A18) is a value only: never a NodeKey, PathSegment
// or PropKey, so the lexer never offers it where a key starts (DD-11 T15).
Value  { String | ConfigString | MultilineString | Number | Bool | Null | Word | Variable | Array | Object }
Word   { qualified }                         // bareword enum: hexagon, down, dashed; or a class, `aws.Lambda` (I16)
qualified { Identifier ("." Identifier)* }   // no node of its own: one set of states for both
Array  { "[" Value* "]" }
Object { "{" Property* "}" }
Property { PropKey ":" Value }
PropKey  { Identifier | String | ConfigKey | ConfigString }  // @-keys allowed inside class bodies

Bool { @specialize<Identifier, "true" | "false"> }
Null { @specialize<Identifier, "null"> }

@tokens {
  space        { @whitespace+ }
  LineComment  { "//" ![\n]* }
  BlockComment { "/*" blockRest }
  blockRest    { ![*] blockRest | "*" blockAfterStar }
  blockAfterStar { "/" | "*" blockAfterStar | ![/*] blockRest }

  // A dash is allowed inside an identifier only when followed by an identifier
  // character, so `a->b` lexes as Identifier EdgeOp Identifier, not `a-` `>b`.
  Identifier   { $[A-Za-z_] ($[A-Za-z0-9_] | "-" $[A-Za-z0-9_])* }
  ConfigKey    { "@" Identifier ("." Identifier)* }
  // The quoted spelling of a ConfigKey — `"@style.stroke"` — is what makes strict
  // JSON able to hold a config entry at all (DD-01 §2, §8). Lexically it is just a
  // String that happens to start with `@`, so it overlaps with String on every
  // such input and needs @precedence below to resolve in its favour.
  ConfigString { '"' "@" (![\\"\n] | "\\" _)* '"' }
  // `$name`, or `$ns.name` for an imported variable (A9, I16). Only `$`
  // starts it, so it overlaps no other token; it grows over the dots of a
  // qualified name, which no production could follow a Variable with anyway
  // (Variable is only a Value, and nothing after a Value starts with ".").
  Variable     { "$" Identifier ("." Identifier)* }
  String       { '"' (![\\"\n] | "\\" _)* '"' }
  // `"""…"""` (A18, DD-11 T15–T19). The body never holds an unescaped `"""`:
  // one quote, or two, must be followed by a character that is not a quote,
  // and `![\\"]` includes newlines. An unterminated one runs to the end of the
  // input (the `@eof` arm), so the editor shows the rest of the file as a
  // string and buildAst reports one SGL1003 for it. Dedent and escapes are
  // buildAst's (T17), not the token's.
  MultilineString { '"""' mlBody ('"""' | '"'? '"'? @eof) }
  mlBody { (mlChar | '"' mlChar | '""' mlChar)* }
  mlChar { ![\\"] | "\\" _ }
  Number     { "-"? @digit+ ("." @digit+)? }
  EdgeOp     { "->" | "<-" | "<->" | "--" }
  // Fan-out over children (*) or descendants (**), optionally narrowed by a name
  // glob with one star: `cam*`, `*-db`, `cam*hd`. Legal only in an edge endpoint,
  // because Path appears only in Endpoint. `*` and globs are valid in any
  // segment; only `**` must be last, and that is a compile concern, not a syntax
  // one (SGL3004) — the grammar stays permissive so a mid-path `**` still
  // yields a usable partial tree.
  //
  // One token, for two reasons. `cam *` must not mean `cam*`, and skipped space
  // would make it so. And the star must be reachable without a dash-swallowing
  // path: globPrefix may end in `-` but is always followed by a required "*", and
  // globSuffix must end in a name character, so `lane1.*->switch` still lexes the
  // `->` as an EdgeOp rather than starting a glob with it.
  Wildcard   { "*" "*"? | "*" globSuffix | globPrefix "*" globSuffix? }
  globPrefix { $[A-Za-z_] ($[A-Za-z0-9_] | "-")* }
  globSuffix { ($[A-Za-z0-9_] | "-")* $[A-Za-z0-9_] }
  Parent     { "../" }
  Root       { "/" }

  "{" "}" "[" "]" ":" "."
  @precedence { LineComment, BlockComment, Root }
  @precedence { Parent, "." }
  // `cam*` matches both Identifier (as `cam`) and Wildcard (whole). Wildcard wins:
  // `*` appears nowhere else in the language, so any position where a Wildcard
  // matches at all is a glob, never an identifier that happens to abut one.
  @precedence { Wildcard, Identifier }
  // Lezer tokenises without lookahead into the parser, so a quoted string that
  // starts with `@` — `"@style.stroke"` as a key, `"@accent"` as a theme-token
  // value — always lexes as ConfigString, never String; ConfigString must win
  // this overlap outright. That is why every production that can hold an
  // ordinary string (Value, NodeValue, EdgeValue, PropKey) also accepts
  // ConfigString: buildAst treats one used as a value exactly like a String.
  //
  // Three tokens start with `"` (DD-01 §2, "The `"""` token audit"). No input
  // is matched in full by two of them, so this line changes nothing today; it
  // says which one wins so that the next token starting with `"` is audited
  // against all three.
  @precedence { MultilineString, ConfigString, String }
}

@detectDelim
