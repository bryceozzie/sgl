{
  "name": "@sgl/core",
  "version": "0.0.0",
  "description": "SGL grammar, parser, resolver, semantic graph and diagnostics. Zero DOM, zero workspace dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./editor": { "types": "./dist/editor.d.ts", "default": "./dist/editor.js" },
    "./json": { "types": "./dist/json.d.ts", "default": "./dist/json.js" },
    "./imports": { "types": "./dist/imports.d.ts", "default": "./dist/imports.js" }
  },
  "scripts": {
    "grammar": "lezer-generator src/grammar/sgl.grammar -o src/grammar/sgl.parser.js",
    "build": "tsdown"
  },
  "dependencies": {
    "@lezer/common": "^1.2.3",
    "@lezer/lr": "^1.4.2"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.10.8",
    "@lezer/highlight": "^1.2.1"
  },
  "peerDependenciesMeta": {
    "@codemirror/language": { "optional": true },
    "@lezer/highlight": { "optional": true }
  },
  "devDependencies": {
    "@codemirror/language": "^6.10.8",
    "@lezer/generator": "^1.8.0",
    "@lezer/highlight": "^1.2.1",
    "fast-check": "^4.3.0"
  }
}
