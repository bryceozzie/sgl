// Inheritance diamond, override order, theme byClass.
@classes: {
  Base:     { @shape: round, @style.strokeWidth: 1 }
  Left:     { @extends: Base, @style.fill: "@surface.sunken" }
  Right:    { @extends: Base, @style.stroke: "@accent" }
  Diamond:  { @extends: [Left, Right] }
  Critical: { @style: { stroke: "@danger", strokeWidth: 3 } }
  Router:   { @ports: { in: west, out: east } }
}

plain:    Base
left:     Left
right:    Right
diamond:  Diamond
both:     { @type: [Diamond, Critical] }
override: { @type: Critical, @style.stroke: "#123456" }

// Ports cascade from a class (DD-02 §7, DD-03 §4): routed gets both of
// Router's ports untouched; routedOverride keeps `in` from the class but
// replaces `out` with its own inline value — inline wins per port id.
routed:         Router
routedOverride: { @type: Router, @ports: { out: west } }

plain -> left -> diamond
right -> both
both -> override
