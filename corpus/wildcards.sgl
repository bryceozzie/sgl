// Wildcard edge endpoints: fan-out, descendants, cross product, ports, labels.
@title: "Wildcards"

switch: { @label: "Switch" }

lane1: {
  @label: "Lane 1"
  a: {}
  b: {}
  c: { @hidden: true }        // not matched
}

lane2: {
  @label: "Lane 2"
  x: {}
  y: {}

  // Parent-relative wildcard, resolved from inside lane2.
  ../lane1.* -> x
}

deep: {
  @label: "Deep"
  top: {
    mid: {
      leaf: {}

      // Root-absolute wildcard, resolved from three levels down.
      leaf -> /lane2.*
    }
  }
}

empty: { @label: "Empty" }    // SGL3003 on any wildcard against it

ported: {
  p: { @ports: { out: east } }
  q: { @ports: { out: east } }
  r: {}                       // SGL2003 — no `out` port
}

// Both-sided wildcard + ports (DD-03 §3.1): every `fan1` child has `out`, so the
// cross product's 6 edges owe SGL2003 to the `fan2` side alone — once per
// distinct portless node (m, n), not once per edge each appears in (which would
// be 3 apiece, 6 total). The one-sided `ported.*` statement below can't tell
// these two counting strategies apart because it only has one portless node.
fan1: {
  x: { @ports: { out: east } }
  y: { @ports: { out: east } }
  z: { @ports: { out: east } }
}
fan2: {
  m: {}
  n: {}
}

// Direct children: two edges, because c is hidden.
lane1.* -> switch

// Reverse direction; the label lands on every expanded edge.
switch -> lane2.*: "distributes"

// Every descendant at any depth, containers included: top, mid, leaf.
deep.** -> switch

// Cross product: 2 x 2 = 4 edges, no self-pairs.
lane1.* -> lane2.*

// Ports ride along; r gets SGL2003 and attaches to its boundary.
ported.*[out] -> switch

// Both sides wildcarded, both sides ported: 3x2 = 6 edges, 2 warnings (m, n),
// not 6 — see the fan1/fan2 comment above.
fan1.*[out] -> fan2.*[in]

// Chains expand per link.
lane1.* -> switch -> lane2.*

// Matches nothing: SGL3003, and only this edge is skipped.
empty.* -> switch
