// expects: SGL2016
// "Billion laughs": each variable doubles the one before, so `$v24` would be
// 2^24 values from a 400-byte document. Substitution stops at the expansion
// budget (DD-09 §1.1) with one error, and the value is dropped.
@vars: { v0: 1, v1: [$v0, $v0], v2: [$v1, $v1], v3: [$v2, $v2], v4: [$v3, $v3], v5: [$v4, $v4], v6: [$v5, $v5], v7: [$v6, $v6], v8: [$v7, $v7], v9: [$v8, $v8], v10: [$v9, $v9], v11: [$v10, $v10], v12: [$v11, $v11], v13: [$v12, $v12], v14: [$v13, $v13], v15: [$v14, $v14], v16: [$v15, $v15], v17: [$v16, $v16], v18: [$v17, $v17], v19: [$v18, $v18], v20: [$v19, $v19], v21: [$v20, $v20], v22: [$v21, $v21], v23: [$v22, $v22], v24: [$v23, $v23] }
a: { @meta: $v24 }
