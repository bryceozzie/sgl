// expects: SGL4003
// A child pinned at a negative offset (DD-12 N12) lies outside its parent's
// content box: under `fixed`, which the document names and the pipeline
// harness honours, that is one SGL4003 ("extends outside its container"), for
// `box.a`, from the host's validation. `box` is pinned too. `c` has no pin:
// it is one SGL4020 (DOWNSTREAM_EXTRA), and it is packed from the content
// box's left edge, not from `box.a`'s negative pin, so it is not outside
// (feat/b5-fixed fix round 1, item 1).
@layout: { engine: fixed }
box: {
  @label: "Box"
  @pin: { x: 0, y: 0 }
  a: { @label: "A", @pin: { x: -40, y: 0 } }
  b: { @label: "B", @pin: { x: 40, y: 0 } }
  c: "C"
}
