// Every node pinned (DD-12 §12). The document names `fixed`, so the pipeline
// harness lays it out under `fixed` (`render-svg/test/pipeline.ts`): each
// frame's top-left is its pin and there is no diagnostic. Under an engine that
// does not honour pins (`grid`, `elk`) each pinned node would be one SGL4021.
@layout: { engine: fixed }
a: { @label: "A", @pin: { x: 0, y: 0 } }
b: { @label: "B", @pin: { x: 200, y: 0 } }
c: { @label: "C", @pin: { x: 100, y: 120 } }
a -> c
b -> c
