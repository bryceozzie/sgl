// expects: SGL4021
// Half pinned (DD-12 §12, N9). Under `fixed` (feat/b5-fixed) `c` and `d` are
// packed below the pinned nodes with one SGL4020 each. Under an engine that
// does not honour pins (grid in the pipeline harness; elk) the two pins are
// one SGL4021 each, the second listed in DOWNSTREAM_EXTRA
// (`packages/render-svg/test/pipeline.test.ts`).
@layout: { engine: fixed }
a: { @label: "A", @pin: { x: 0, y: 0 } }
b: { @label: "B", @pin: { x: 160, y: 40 } }
c: "C"
d: "D"
a -> c
b -> d
