// MVP criterion 1 for `fixed` (DD-12 §12 item 5): `forty-three-level.sgl` with
// a `@pin` on every node, taken once from its `grid` layout. Generated by
// `bench/generate-pinned-fixture.js`; do not hand-edit. Every node is pinned,
// so under `fixed` it lays out with no diagnostic; under an engine without
// pins it would be one SGL4021 per node.
@title: "Forty, three levels"
@layout: { engine: fixed }

frontend: {
  @pin: { x: 0, y: 0 }
  @label: "Frontend"

  web: {
    @pin: { x: 0, y: 0 }
    @label: "Web"
    home: { @pin: { x: 2, y: 0 } }
    search: { @pin: { x: 100, y: 0 } }
    cart: { @pin: { x: 196, y: 0 } }
    checkout: { @pin: { x: 0, y: 60 } }
    profile: { @pin: { x: 100, y: 60 } }
    orders: { @pin: { x: 196, y: 60 } }
    support: { @pin: { x: 2, y: 120 } }
    admin: { @pin: { x: 100, y: 120 } }
    reports: { @pin: { x: 196, y: 120 } }
  }

  mobile: {
    @pin: { x: 324, y: 0 }
    @label: "Mobile"
    ios: { @pin: { x: 9, y: 0 } }
    android: { @pin: { x: 113, y: 0 } }
    push: { @pin: { x: 209, y: 0 } }
    sync: { @pin: { x: 9, y: 60 } }
    cache: { @pin: { x: 113, y: 60 } }
    auth: { @pin: { x: 209, y: 60 } }
    onboarding: { @pin: { x: 0, y: 120 } }
    settings: { @pin: { x: 113, y: 120 } }
  }
}

backend: {
  @pin: { x: 693, y: 0 }
  @label: "Backend"

  api: {
    @pin: { x: 0, y: 0 }
    @label: "API"
    gateway: { @pin: { x: 10, y: 0 } }
    users: { @pin: { x: 119, y: 0 } }
    orders: { @pin: { x: 245, y: 0 } }
    payments: { @pin: { x: 6, y: 60 } }
    inventory: { @pin: { x: 117, y: 60 } }
    shipping: { @pin: { x: 245, y: 60 } }
    notifications: { @pin: { x: 0, y: 120 } }
    search: { @pin: { x: 119, y: 120 } }
    recommendations: { @pin: { x: 217, y: 120 } }
  }

  data: {
    @pin: { x: 401, y: 0 }
    @label: "Data"
    primary: { @pin: { x: 0, y: 0 } }
    replica: { @pin: { x: 96, y: 0 } }
    warehouse: { @pin: { x: 192, y: 0 } }
    cache: { @pin: { x: 0, y: 60 } }
    queue: { @pin: { x: 96, y: 60 } }
    blob: { @pin: { x: 200, y: 60 } }
    search: { @pin: { x: 0, y: 120 } }
    backup: { @pin: { x: 96, y: 120 } }
  }
}

// Root-level edges need the full path from root (DD-02 §5) — these are three
// segments deep (container.container.leaf), same shape as nesting-3.sgl's
// `platform.services.worker -> /external.cdn`.
frontend.web.home -> frontend.web.search
frontend.web.search -> frontend.web.cart
frontend.web.cart -> frontend.web.checkout
frontend.web.checkout -> backend.api.orders
frontend.web.checkout -> backend.api.payments
frontend.mobile.ios -> backend.api.gateway
frontend.mobile.android -> backend.api.gateway
backend.api.gateway -> backend.api.users
backend.api.orders -> backend.data.primary
backend.api.payments -> backend.data.primary
backend.data.primary -> backend.data.replica
backend.api.search -> backend.data.search
backend.api.notifications -> backend.data.queue
frontend.mobile.push -> backend.api.notifications
