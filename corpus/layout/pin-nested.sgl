// Nested relative pins (DD-12 N2, H2): a pin is the frame's top-left relative
// to the top-left of its parent's content box. `box` sits at (300, 100) in
// the diagram; `box.a` and `box.b` at (0, 0) and (120, 0) inside it, however
// far `box` is moved. Under `fixed`, which the document names and the
// pipeline harness honours: no diagnostic.
@layout: { engine: fixed }
box: {
  @label: "Box"
  @pin: { x: 300, y: 100 }
  a: { @label: "A", @pin: { x: 0, y: 0 } }
  b: { @label: "B", @pin: { x: 120, y: 0 } }
  a -> b
}
