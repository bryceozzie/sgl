// expects: SGL4021
// Nested relative pins (DD-12 N2, H2): a pin is the frame's top-left relative
// to the top-left of its parent's content box. `box` sits at (300, 100) in
// the diagram; `box.a` and `box.b` at (0, 0) and (120, 0) inside it, however
// far `box` is moved. Under `fixed` (feat/b5-fixed): no diagnostic. Under an
// engine that does not honour pins (grid in the pipeline harness; elk): one
// SGL4021 per pinned node, three, two listed in DOWNSTREAM_EXTRA
// (`packages/render-svg/test/pipeline.test.ts`).
@layout: { engine: fixed }
box: {
  @label: "Box"
  @pin: { x: 300, y: 100 }
  a: { @label: "A", @pin: { x: 0, y: 0 } }
  b: { @label: "B", @pin: { x: 120, y: 0 } }
  a -> b
}
