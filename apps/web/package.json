{
  "name": "@sgl/web",
  "version": "0.0.0",
  "description": "The SGL editor: CodeMirror on the left, live SVG on the right. Entirely client-side.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cf:dev": "pnpm dlx wrangler@4.141.0 dev",
    "cf:deploy": "pnpm dlx wrangler@4.141.0 deploy",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:all-browsers": "playwright test --project=chromium --project=firefox --project=webkit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.19.2",
    "@codemirror/commands": "^6.9.1",
    "@codemirror/language": "^6.11.4",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.1",
    "@preact/signals": "^2.0.0",
    "@sgl/core": "workspace:*",
    "@sgl/layout-api": "workspace:*",
    "@sgl/layout-elk": "workspace:*",
    "@sgl/layout-std": "workspace:*",
    "@sgl/measure": "workspace:*",
    "@sgl/render-svg": "workspace:*",
    "@sgl/text": "workspace:*",
    "@sgl/theme": "workspace:*",
    "idb": "^8.0.3",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@preact/preset-vite": "^2.10.2",
    "terser": "^5.51.2",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.3.0"
  }
}
